{
  "name": "@kyasi/pokebattle-engine",
  "version": "0.2.0",
  "description": "Pokémon singles battle engine (Gen 9) written in TypeScript — damage calc, turn engine, AI, random teams",
  "author": "kyasi",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "prepare": "tsup",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "simulate": "tsx scripts/simulate.ts",
    "bench": "tsx scripts/bench.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.build.json"
  },
  "keywords": [
    "pokemon",
    "battle",
    "engine",
    "damage-calculator",
    "showdown",
    "simulator"
  ],
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false
}
