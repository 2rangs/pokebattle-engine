{
  "name": "@kyasi/pokebattle-engine",
  "version": "1.0.0",
  "description": "Pokémon Showdown 시뮬레이터 기반 배틀 엔진 — PokeAPI 슬러그/한국어 이름, @smogon/calc 데미지 계산, AI, 퍼징 테스트",
  "author": "kyasi",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "prepare": "tsup",
    "simulate": "tsx scripts/simulate.ts",
    "bench": "tsx scripts/bench.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "fetch-pokeapi": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-pokeapi.ts",
    "fuzz": "tsup && node scripts/fuzz.ts"
  },
  "keywords": [
    "pokemon",
    "showdown",
    "battle",
    "engine",
    "damage-calculator",
    "pokeapi",
    "simulator"
  ],
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@pkmn/randoms": "^0.11.0",
    "@pkmn/sim": "^0.11.0",
    "@smogon/calc": "^0.12.0"
  }
}
